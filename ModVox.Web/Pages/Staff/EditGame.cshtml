@page "/staff/edit/game/{gameId:guid}"
@model ModVox.Web.Pages.Staff.EditGameModel
@{
    ViewData["Title"] = "Edit Game";
}

<section class="site-shell staff-card staff-card-wide">
    <h1 class="md-heading md-h1">Edit Game</h1>
    <p class="md-paragraph staff-muted">Admin controls for game settings.</p>
    <p class="md-paragraph"><code class="md-inline-code">@Model.GameId</code></p>

    <form id="game-form" class="staff-form staff-panel">
        <div class="staff-grid-2">
            <div>
                <label class="staff-label" for="game-name">Game Name</label>
                <input id="game-name" class="staff-input" required />
            </div>
            <div>
                <label class="staff-label" for="game-slug">Slug</label>
                <input id="game-slug" class="staff-input" required />
            </div>
        </div>
        <label class="staff-label">
            <input id="game-hidden" type="checkbox" /> Hidden
        </label>
        <button class="staff-button" type="submit">Save Game</button>
    </form>

    <p id="edit-game-status" class="staff-status"></p>

    @if (!string.IsNullOrWhiteSpace(Model.StaffHelpHtml))
    {
        <section class="staff-panel">@Html.Raw(Model.StaffHelpHtml)</section>
    }

    <p class="md-paragraph"><a class="md-link" href="/staff/games">Back to Manage Games</a></p>
</section>

@section Scripts {
    <script>
        const gameId = '@Model.GameId';
        const status = document.getElementById('edit-game-status');

        async function loadGame() {
            const r = await fetch('/api/v1/admin/games/' + gameId);
            if (!r.ok) {
                status.textContent = 'Failed to load game.';
                return;
            }
            const g = await r.json();
            document.getElementById('game-name').value = g.name;
            document.getElementById('game-slug').value = g.slug;
            document.getElementById('game-hidden').checked = !!g.is_hidden;
        }

        document.getElementById('game-form').addEventListener('submit', async e => {
            e.preventDefault();
            try {
                const payload = {
                    name: document.getElementById('game-name').value,
                    slug: document.getElementById('game-slug').value,
                    isHidden: document.getElementById('game-hidden').checked
                };
                const r = await fetch('/api/v1/admin/games/' + gameId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (!r.ok) throw new Error();
                status.textContent = 'Game updated.';
            } catch {
                status.textContent = 'Failed to update game.';
            }
        });

        loadGame();
    </script>
}
