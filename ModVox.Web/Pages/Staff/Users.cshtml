@page "/staff/users"
@model ModVox.Web.Pages.Staff.UsersModel
@{
    ViewData["Title"] = "Manage Users";
}

<section class="site-shell staff-card">
    <h1 class="md-heading md-h1">Manage Users</h1>
    <p class="md-paragraph staff-muted">Search, paginate, and edit users from one place.</p>

    <div class="staff-toolbar">
        <form id="user-search-form" class="staff-form staff-grow">
            <label class="staff-label" for="user-search">Search users</label>
            <div class="staff-inline">
                <input class="staff-input" id="user-search" placeholder="username, display, email" />
                <button class="staff-button" type="submit">Search</button>
            </div>
        </form>
        <button id="toggle-create-user" class="staff-button" type="button">Add New</button>
    </div>

    <section id="create-user-panel" class="staff-panel" hidden>
        <h2 class="md-heading md-h2">Add New User</h2>
        <form id="create-user-form" class="staff-form">
            <div class="staff-grid-2">
                <div>
                    <label class="staff-label" for="new-username">Username</label>
                    <input class="staff-input" id="new-username" required />
                </div>
                <div>
                    <label class="staff-label" for="new-email">Email</label>
                    <input class="staff-input" id="new-email" type="email" required />
                </div>
                <div>
                    <label class="staff-label" for="new-password">Password</label>
                    <input class="staff-input" id="new-password" type="password" required />
                </div>
                <div>
                    <label class="staff-label" for="new-role">Role</label>
                    <select class="staff-input" id="new-role">
                        <option>maintainer</option>
                        <option>moderator</option>
                        <option>admin</option>
                        <option>user</option>
                    </select>
                </div>
            </div>
            <div class="staff-inline">
                <button class="staff-button" type="submit">Create User</button>
                <button id="cancel-create-user" class="staff-button staff-button-secondary"
                        type="button">Cancel</button>
            </div>
        </form>
    </section>

    <hr class="staff-divider" />

    <div id="users-list" class="staff-table-wrap"></div>
    <div class="staff-pagination">
        <button class="staff-button staff-button-secondary" id="prev-page" type="button">Previous</button>
        <span id="page-state" class="staff-muted">Page 1</span>
        <button class="staff-button staff-button-secondary" id="next-page" type="button">Next</button>
    </div>
    <p id="users-status" class="staff-status"></p>

    @if (!string.IsNullOrWhiteSpace(Model.StaffHelpHtml))
    {
        <section class="staff-panel">@Html.Raw(Model.StaffHelpHtml)</section>
    }

    <p class="md-paragraph"><a class="md-link" href="/staff">Back to staff</a></p>
</section>

@section Scripts {
    <script>
        let currentPage = 1;
        let totalPages = 1;
        let currentQuery = '';

        const usersList = document.getElementById('users-list');
        const usersStatus = document.getElementById('users-status');
        const pageState = document.getElementById('page-state');
        const createPanel = document.getElementById('create-user-panel');
        const toggleCreate = document.getElementById('toggle-create-user');
        const cancelCreate = document.getElementById('cancel-create-user');

        function esc(v) {
            return String(v ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');
        }

        async function loadUsers() {
            usersStatus.textContent = 'Loading users...';
            const params = new URLSearchParams({ page: String(currentPage), pageSize: '12' });
            if (currentQuery) params.set('q', currentQuery);
            const r = await fetch('/api/v1/admin/users?' + params.toString());
            if (!r.ok) {
                usersStatus.textContent = 'Failed to load users.';
                return;
            }
            const data = await r.json();
            totalPages = data.total_pages || 1;
            currentPage = data.page || 1;
            pageState.textContent = 'Page ' + currentPage + ' of ' + totalPages;
            const items = data.items || [];
            if (items.length === 0) {
                usersList.innerHTML = '<p class="md-paragraph">No users found.</p>';
                usersStatus.textContent = '';
                return;
            }
            const rows = items.map(u =>
                `<tr>
                    <td>${esc(u.username)}</td>
                    <td>${esc(u.displayName)}</td>
                    <td>${esc(u.email)}</td>
                    <td>${esc(u.role)}</td>
                    <td class="staff-actions-cell">
                        <button class="staff-button staff-button-secondary" type="button" onclick="editUser('${u.userId}')">Edit</button>
                    </td>
                </tr>`
            ).join('');
            usersList.innerHTML = `<table class="staff-table">
                <thead><tr><th>Username</th><th>Display</th><th>Email</th><th>Role</th><th class="staff-actions-cell">Actions</th></tr></thead>
                <tbody>${rows}</tbody>
            </table>`;
            usersStatus.textContent = '';
        }

        window.editUser = function (userId) {
            window.location.href = '/staff/edit/user/' + userId;
        };

        toggleCreate.addEventListener('click', () => {
            const open = createPanel.hidden;
            createPanel.hidden = !open;
            toggleCreate.textContent = open ? 'Hide New User' : 'Add New';
        });

        cancelCreate.addEventListener('click', () => {
            createPanel.hidden = true;
            toggleCreate.textContent = 'Add New';
        });

        document.getElementById('create-user-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const payload = {
                username: document.getElementById('new-username').value,
                email: document.getElementById('new-email').value,
                password: document.getElementById('new-password').value,
                role: document.getElementById('new-role').value
            };
            const r = await fetch('/api/v1/admin/users', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (!r.ok) {
                usersStatus.textContent = 'Create user failed.';
                return;
            }
            usersStatus.textContent = 'User created.';
            e.target.reset();
            createPanel.hidden = true;
            toggleCreate.textContent = 'Add New';
            await loadUsers();
        });

        document.getElementById('user-search-form').addEventListener('submit', (e) => {
            e.preventDefault();
            currentQuery = document.getElementById('user-search').value.trim();
            currentPage = 1;
            loadUsers();
        });

        document.getElementById('prev-page').addEventListener('click', () => {
            if (currentPage > 1) { currentPage--; loadUsers(); }
        });

        document.getElementById('next-page').addEventListener('click', () => {
            if (currentPage < totalPages) { currentPage++; loadUsers(); }
        });

        loadUsers();
    </script>
}
