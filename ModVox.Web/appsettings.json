{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=modvox;Username=modvox;Password=modvox"
  },
  "Valkey": {
    "ConnectionString": "valkey:6379"
  },
  "Refresh": {
    "MinIntervalMinutes": 10
  },
  "Cache": {
    "ReadmeTtlMinutes": 30,
    "ImagesTtlMinutes": 15,
    "ReleasesTtlMinutes": 10,
    "ListingTtlMinutes": 5,
    "PageTtlMinutes": 3,
    "NegativeTtlMinutes": 2,
    "StaleWindowMinutes": 5
  },
  "Providers": {
    "GitHub": {
      "ApiBaseUrl": "https://api.github.com",
      "RawBaseUrl": "https://raw.githubusercontent.com",
      "TimeoutSeconds": 15
    }
  },
  "Thunderstore": {
    "OpenApiUrl": "https://thunderstore.io/api/docs/?format=openapi",
    "PackageIndexUrl": "https://thunderstore.io/api/experimental/package-index/"
  },
  "Tags": {
    "DefaultSeedLabels": [
      "client-side",
      "server-side",
      "quality-of-life",
      "content",
      "utility"
    ]
  },
  "AllowedHosts": "*"
}
